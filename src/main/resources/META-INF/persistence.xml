<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- RESOURCE_LOCAL : pas de serveur JEE, c'est l'application qui gère les transactions -->
    <persistence-unit name="medecinePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>Model.Patient</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- url / user / password : lus dans db.properties par Util.JPAUtil -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- La table est créée par base.sql : Hibernate ne touche pas au schéma -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>

            <!-- Mettre à true pour voir les requêtes SQL dans catalina.out -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
